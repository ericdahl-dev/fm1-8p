# Pinned inputs of the FM-1 firmware build (tools/fm1-build.sh). Every download is checked against
# these; a mismatch stops the build. Change a pin only with a test build and a note in the PR.

# fm1-dock (GPL-3.0-only): host firmware, module ABI 2, build checks. Fetched, not vendored.
FM1_DOCK_REPO=https://github.com/joakimeriksson/fm1-dock.git
FM1_DOCK_SHA=9e6e08e56a43d62fface7ee99c594f65fdf0fccc

# JieLi Linux toolchain, clang 4.0.1 for pi32v2. The URL always serves JieLi's latest, so the
# tarball hash and its top directory are the pin.
JIELI_TOOLCHAIN_URL=https://pkgman.jieliapp.com/s/linux-toolchain
JIELI_TOOLCHAIN_SHA256=a1545cddbc451a06bac43eb5cd96d831470c42a97c5c0b1f98879a20fc7647bd
JIELI_TOOLCHAIN_DIR=jieli-linux-toolchains-20260730.1

# JieLi AC79 SDK, tag AC79NN_SDK_V1.2.1_2023-12-13. The package needs three files from it.
AC79_SDK_RAW=https://gitee.com/Jieli-Tech/fw-AC79_AIoT_SDK/raw
AC79_SDK_COMMIT=d179b4484759423312073f5fbb232501aa491047
AC79_SDK_FILES="uboot.boot:4e3b4c220dc96641cb5a723f41e68ce41d5261ae9434bb33fbd7f2c59976ded4 cfg_tool.bin:276579954f076886a6a7694f65dc71c034a63a2c204b76749065c0ac7b010d1b cfg/eq_cfg_hw.bin:41167491bffed4651750719c973d2758adeb9021a5670d02d6a53c85ed80ea7d"

# Python for fm1-dock's build scripts.
PILLOW_VERSION=13.0.0

# fm1-emu (MIT): the CPU-budget run in strict timing mode.
FM1_EMU_URL=https://github.com/joakimeriksson/fm1-emu/releases/download/v0.4.0/fm1-emu-0.4.0-linux-x86_64.tar.gz
FM1_EMU_SHA256=b6a921ff2f8ec89b0af661d89d733f6ea880222c1b546a49845037e64b86f07d
FM1_EMU_DIR=fm1-emu-0.4.0-linux-x86_64

# The solo .fwsc's package identity (Eric, 2026-11-10). Re-check it is free on the Firmware Hub
# before any public release.
FM1_IDENTITY=FM-1_948
